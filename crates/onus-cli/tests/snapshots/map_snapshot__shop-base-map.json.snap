      "id": "billing:src/discount.test.ts",
      "componentId": "billing",
      "file": "services/billing/src/discount.test.ts",
      "cases": [
        {
          "name": "applyDiscount › gives loyalty members 10% off large orders",
          "line": 5,
          "endLine": 10,
          "assertions": [
            {
              "text": "expect(result.discountCents).toBe(2000)",
              "line": 7
            },
            {
              "text": "expect(result.totalCents).toBe(18000)",
              "line": 8
            },
            {
              "text": "expect(result.reason).toBe(\"loyalty\")",
              "line": 9
            }
          ],
          "expected": [
            {
              "text": "toBe:2000",
              "line": 7
            },
            {
              "text": "toBe:18000",
              "line": 8
            },
            {
              "text": "toBe:\"loyalty\"",
              "line": 9
            }
          ],
          "fingerprint": "c46f231a72e75454"
        },
        {
          "name": "applyDiscount › does not discount an order exactly at the threshold",
          "line": 12,
          "endLine": 16,
          "assertions": [
            {
              "text": "expect(result.discountCents).toBe(0)",
              "line": 14
            },
            {
              "text": "expect(result.totalCents).toBe(10000)",
              "line": 15
            }
          ],
          "expected": [
            {
              "text": "toBe:0",
              "line": 14
            },
            {
              "text": "toBe:10000",
              "line": 15
            }
          ],
          "fingerprint": "344d816e40d6f7c6"
        },
        {
          "name": "applyDiscount › does not discount small orders",
          "line": 18,
          "endLine": 21,
          "assertions": [
            {
              "text": "expect(result.totalCents).toBe(5000)",
              "line": 20
            }
          ],
          "expected": [
            {
              "text": "toBe:5000",
              "line": 20
            }
          ],
          "fingerprint": "e3c00b974c355f09"
        },
        {
          "name": "applyDiscount › does not discount customers outside the loyalty program",
          "line": 23,
          "endLine": 26,
          "assertions": [
            {
              "text": "expect(result.reason).toBe(\"none\")",
              "line": 25
            }
          ],
          "expected": [
            {
              "text": "toBe:\"none\"",
              "line": 25
            }
          ],
          "fingerprint": "a217c48fb94fd8cd"
        },
        {
          "name": "applyDiscount › rounds the discount to whole cents",
          "line": 28,
          "endLine": 32,
          "assertions": [
            {
              "text": "expect(result.discountCents).toBe(1002)",
              "line": 30
            },
            {
              "text": "expect(result.totalCents).toBe(9013)",
              "line": 31
            }
          ],
          "expected": [
            {
              "text": "toBe:1002",
              "line": 30
            },
            {
              "text": "toBe:9013",
              "line": 31
            }
          ],
          "fingerprint": "21d6680316a70d33"
        }
