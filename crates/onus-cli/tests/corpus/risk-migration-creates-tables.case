=== head libs/db/src/migrations/1790000013000-createPosts.ts
import type { MigrationInterface, QueryRunner } from 'typeorm';

export class CreatePosts1790000013000 implements MigrationInterface {
  async up(q: QueryRunner): Promise<void> {
    await q.query(`
      CREATE TABLE posts (
        id uuid PRIMARY KEY,
        publisher_id uuid NOT NULL REFERENCES publishers(id) ON DELETE CASCADE,
        body text NOT NULL
      )
    `);
    await q.query(`CREATE TABLE post_comments (id uuid PRIMARY KEY, post_id uuid REFERENCES posts(id) ON DELETE CASCADE)`);
    await q.query(`ALTER TABLE publishers ADD COLUMN cv_pdf bytea`);
  }

  async down(q: QueryRunner): Promise<void> {
    await q.query(`DROP TABLE post_comments`);
    await q.query(`DROP TABLE posts`);
  }
}
