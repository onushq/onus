A dependency patch is swapped: the patch file, the workspace's
`patchedDependencies` and the lockfile's patch hashes change, but no
installed version does. The patch itself is third-party code being changed
and needs a person; the lockfile is not a version change.

=== both package.json
{ "name": "r", "private": true, "dependencies": { "left-pad": "1.3.0", "builder": "2.1.0" } }
=== both src/index.ts
export const x = 1;
=== base pnpm-workspace.yaml
packages:
  - .
patchedDependencies:
  builder@2.1.0: patches/builder@2.1.0.patch
=== head pnpm-workspace.yaml
packages:
  - .
patchedDependencies:
  left-pad@1.3.0: patches/left-pad@1.3.0.patch
=== base patches/builder@2.1.0.patch
diff --git a/dist/resolve.js b/dist/resolve.js
--- a/dist/resolve.js
+++ b/dist/resolve.js
@@ -1,3 +1,4 @@
 module.exports = function resolve(paths) {
-  return paths;
+  return paths.filter((p) => !p.includes('node_modules'));
 };
=== head patches/left-pad@1.3.0.patch
diff --git a/index.d.ts b/index.d.ts
--- a/index.d.ts
+++ b/index.d.ts
@@ -1,1 +1,1 @@
-export default function leftPad(s: string, n: number): string;
+export default function leftPad(s: string, n: number, ch?: string): string;
=== base pnpm-lock.yaml
lockfileVersion: '9.0'

patchedDependencies:
  builder@2.1.0:
    hash: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
    path: patches/builder@2.1.0.patch

importers:
  .:
    dependencies:
      builder:
        specifier: 2.1.0
        version: 2.1.0(patch_hash=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa)
      left-pad:
        specifier: 1.3.0
        version: 1.3.0

packages:
  builder@2.1.0:
    resolution: {integrity: sha512-b}
  left-pad@1.3.0:
    resolution: {integrity: sha512-l}

snapshots:
  builder@2.1.0(patch_hash=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa): {}
  left-pad@1.3.0: {}
=== head pnpm-lock.yaml
lockfileVersion: '9.0'

patchedDependencies:
  left-pad@1.3.0:
    hash: bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
    path: patches/left-pad@1.3.0.patch

importers:
  .:
    dependencies:
      builder:
        specifier: 2.1.0
        version: 2.1.0
      left-pad:
        specifier: 1.3.0
        version: 1.3.0(patch_hash=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb)

packages:
  builder@2.1.0:
    resolution: {integrity: sha512-b}
  left-pad@1.3.0:
    resolution: {integrity: sha512-l}

snapshots:
  builder@2.1.0: {}
  left-pad@1.3.0(patch_hash=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb): {}
=== expect
no lockfile-changed why~"versions change without a manifest change"
row dependency-patched ● title~"`builder@2.1.0`" title~"no longer patched"
row dependency-patched ● title~"`left-pad@1.3.0`" title~"patched"
