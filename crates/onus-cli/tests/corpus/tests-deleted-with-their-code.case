export function formatName(first: string, last: string): string {
  return `${first} ${last}`;
}
=== base src/legacy.ts
export function legacyFormat(name: string): string {
  return name.toUpperCase();
}
=== base src/legacy.spec.ts
import { legacyFormat } from './legacy';

it('upper-cases', () => {
  expect(legacyFormat('a')).toBe('A');
});
it('keeps empty names', () => {
  expect(legacyFormat('')).toBe('');
});
