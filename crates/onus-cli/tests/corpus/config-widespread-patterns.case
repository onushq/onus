Many project configs change at once, in two different ways: six drop a
`module` override and two drop their `exclude` list. A row per component
would bury the second pattern; one row for everything would hide it. Each
kind of edit reads as its own row.

=== both package.json
{ "name": "r", "private": true, "workspaces": ["libs/*"] }
=== both libs/l1/package.json
{ "name": "@r/l1", "private": true, "main": "src/index.ts" }
=== both libs/l1/src/index.ts
export const l1 = 0;
=== base libs/l1/tsconfig.json
{ "compilerOptions": { "module": "commonjs", "strict": true } }
=== head libs/l1/tsconfig.json
{ "compilerOptions": { "strict": true } }
=== both libs/l2/package.json
{ "name": "@r/l2", "private": true, "main": "src/index.ts" }
=== both libs/l2/src/index.ts
export const l2 = 1;
=== base libs/l2/tsconfig.json
{ "compilerOptions": { "module": "commonjs", "strict": true } }
=== head libs/l2/tsconfig.json
{ "compilerOptions": { "strict": true } }
