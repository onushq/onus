=== base packages/engine/src/index.ts
export interface Engine {
  start(): void;
}
export { createEngine } from './live';
=== head packages/engine/src/index.ts
export interface Engine {
  start(): void;
  refresh(): Promise<void>;
}
export { createEngine } from './live';
=== base packages/engine/src/live.ts
import type { Engine } from './index';

export function createEngine(): Engine {
  return {
    start() {},
  };
}
=== head packages/engine/src/live.ts
import type { Engine } from './index';

export function createEngine(): Engine {
  return {
    start() {},
    async refresh() {},
  };
}
=== both packages/app/src/index.ts
import { createEngine, type Engine } from '@r/engine';

export const engine: Engine = createEngine();
export function boot(): void {
  engine.start();
}
=== both packages/app/src/boot.spec.ts
import type { Engine } from '@r/engine';
import { boot } from './index';

const fake = { start: () => {} } as Engine;
const other = {} as never;

it('boots', () => {
  boot();
  expect(fake).toBeDefined();
  expect(other).toBeUndefined();
});
