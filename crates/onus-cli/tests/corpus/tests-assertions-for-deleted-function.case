{ "name": "calendar", "private": true, "main": "src/index.ts" }
=== base src/index.ts
export function cardId(recordId: string): string {
  return `card-${recordId}`;
}
export function recordIdFromCardId(id: string): string {
  return id.replace('card-', '');
}
