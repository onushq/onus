{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OnusConfig",
  "type": "object",
  "properties": {
    "components": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ComponentConfig"
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ContractConfig"
      }
    },
    "environment": {
      "description": "Environments that run the change and record evidence\n(`onus help environments`).",
      "anyOf": [
        {
          "$ref": "#/$defs/EnvironmentConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "extractors": {
      "$ref": "#/$defs/ExtractorsConfig",
      "default": {}
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/LabelConfig"
      }
    },
    "lanes": {
      "description": "Risk lanes: what happens to a change after it is reported\n(`onus help lanes`).",
      "anyOf": [
        {
          "$ref": "#/$defs/LanesConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RuleConfig"
      }
    },
    "testData": {
      "description": "Globs of files that are test data, not code: fixtures, sample\nprojects, recorded responses. They are left out of the map, and\nsecret-shaped values added in them are noted without counting as\ncommitted secrets.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "$ref": "#/$defs/TestsConfig",
      "default": {}
    },
    "version": {
      "description": "Format version; must be 1.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "$defs": {
    "CheckCommand": {
      "description": "A command run in a container against the change.",
      "type": "object",
      "properties": {
        "command": {
          "description": "The command, run with `sh -c` and no network.",
          "type": "string"
        },
        "image": {
          "description": "The container image. Default `node:22`.",
          "type": [
            "string",
            "null"
          ]
        },
        "setup": {
          "description": "A setup command run first, with network (such as `npm ci`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "command"
      ]
    },
    "ComponentConfig": {
      "type": "object",
      "properties": {
        "entrypoints": {
          "description": "Source files that define the public surface. Inferred from\n`package.json` when absent.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "description": "Glob (or list of globs) of the component's files, e.g. `services/orders/**`.",
          "$ref": "#/$defs/OneOrMany"
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "ComponentKind": {
      "type": "string",
      "enum": [
        "package",
        "service",
        "module"
      ]
    },
    "ConfidenceInput": {
      "type": "object",
      "properties": {
        "low": {
          "description": "The lane of a change with a row that rests on parts of the map Onus\ncould not resolve. Default `judge`; `auto-merge` turns it off.",
          "$ref": "#/$defs/Lane",
          "default": "judge"
        }
      },
      "additionalProperties": false
    },
    "ContractConfig": {
      "type": "object",
      "properties": {
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "symbol": {
          "description": "Map id of the symbol, e.g. `user-preferences:src/types.ts#UserPreferences`.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "symbol"
      ]
    },
    "EnvironmentConfig": {
      "description": "A disposable environment: a container built from the repository at a\ncommit. Read from the operator's working tree, never from the commit\nunder test, so a change cannot alter its own environment.",
      "type": "object",
      "properties": {
        "egressImage": {
          "description": "The egress proxy image, started when a task's token names hosts.\nDefault `ubuntu/squid`.",
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "description": "Globs of test result files (JUnit XML) a run writes, kept as evidence.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "image": {
          "description": "The container image. Default: the devcontainer's image.",
          "type": [
            "string",
            "null"
          ]
        },
        "lockfiles": {
          "description": "Files whose contents decide when the warm image is rebuilt. Default:\nthe usual lockfiles.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "seed": {
          "description": "Loads synthetic data into a new environment, after setup.",
          "type": [
            "string",
            "null"
          ]
        },
        "setup": {
          "description": "Installs dependencies, with network, once per image, setup command\nand lockfile contents; the result is kept as a warm image.",
          "type": [
            "string",
            "null"
          ]
        },
        "traces": {
          "description": "Globs of OpenTelemetry trace files (OTLP JSON) a run writes, kept as\nevidence.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "EventPatterns": {
      "type": "object",
      "properties": {
        "publish": {
          "description": "Call patterns such as `bus.publish($EVENT, ...)` or `@OnEvent($EVENT)`.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "subscribe": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ExternalSpec": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string"
        },
        "egress": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vendor": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "vendor",
        "category"
      ]
    },
    "ExtractorsConfig": {
      "type": "object",
      "properties": {
        "events": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventPatterns"
            },
            {
              "type": "null"
            }
          ]
        },
        "externals": {
          "description": "Extra external services, keyed by npm package name.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ExternalSpec"
          }
        },
        "packs": {
          "description": "Framework packs: YAML files of tree-sitter queries, relative to\nonus.yaml (`onus help plugins`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prisma": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrismaConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "HistoryInput": {
      "type": "object",
      "properties": {
        "days": {
          "description": "How many days back the outcome records count (1 to 3650). Default 90.",
          "type": "integer",
          "format": "uint32",
          "default": 90,
          "minimum": 0
        },
        "incidents": {
          "description": "Incidents per component. Default `{ human: 1 }`.",
          "$ref": "#/$defs/Thresholds",
          "default": {
            "human": 1
          }
        },
        "reverts": {
          "description": "Reverts and rollbacks per component. Default `{ judge: 1 }`.",
          "$ref": "#/$defs/Thresholds",
          "default": {
            "judge": 1
          }
        }
      },
      "additionalProperties": false
    },
    "LabelConfig": {
      "type": "object",
      "properties": {
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        }
      },
      "additionalProperties": false,
      "required": [
        "sensitivity"
      ]
    },
    "Lane": {
      "description": "What happens to a change, from least to most scrutiny.",
      "oneOf": [
        {
          "description": "Merged once required checks pass.",
          "type": "string",
          "const": "auto-merge"
        },
        {
          "description": "Verified by the judge (`onus judge`), then merged or escalated.",
          "type": "string",
          "const": "judge"
        },
        {
          "description": "A person reviews it.",
          "type": "string",
          "const": "human"
        },
        {
          "description": "It may not merge as it is.",
          "type": "string",
          "const": "blocked"
        }
      ]
    },
    "LaneRule": {
      "type": "object",
      "properties": {
        "components": {
          "description": "Components; empty matches any.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kinds": {
          "description": "Row kinds (`internal`, `additive`, `config`, …); empty matches any.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "labels": {
          "description": "Sensitivity labels; empty matches any.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lane": {
          "$ref": "#/$defs/Lane"
        },
        "match": {
          "description": "`any` (default): the rule applies when any row matches. `every`: when\nevery row matches (and the change has rows).",
          "$ref": "#/$defs/RuleMatch",
          "default": "any"
        },
        "subkinds": {
          "description": "Row subkinds (`migration-changed`, …); empty matches any.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "lane"
      ]
    },
    "LanesConfig": {
      "type": "object",
      "properties": {
        "auditAfterMerge": {
          "description": "The share of changes approved without a person (`auto-merge`, or the\njudge's `approve`) that wait for a person to audit after they merge,\nchosen by a hash of the merge commit (0 to 1). Default 0.05.",
          "type": "number",
          "format": "double",
          "default": 0.05
        },
        "auditRate": {
          "description": "The share of would-be `auto-merge` changes sent to a person before\nmerging, chosen by a hash of the head commit (0 to 1). Default 0.05.",
          "type": "number",
          "format": "double",
          "default": 0.05
        },
        "default": {
          "description": "The lane of a change no rule speaks about. Default `judge`.",
          "$ref": "#/$defs/Lane",
          "default": "judge"
        },
        "heldOut": {
          "description": "Checks the author never saw, run by the judge in a container.",
          "anyOf": [
            {
              "$ref": "#/$defs/CheckCommand"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputs": {
          "description": "Built-in risk inputs; each can only raise a lane (`onus help lanes`).",
          "$ref": "#/$defs/RiskInputs",
          "default": {
            "blastRadius": {
              "judge": 3
            },
            "confidence": {
              "low": "judge"
            },
            "history": {
              "days": 90,
              "incidents": {
                "human": 1
              },
              "reverts": {
                "judge": 1
              }
            },
            "tests": {
              "untested": "judge"
            }
          }
        },
        "learned": {
          "description": "A learned model that may raise a change's lane, never lower it\n(`onus help lanes`). Off unless written.",
          "anyOf": [
            {
              "$ref": "#/$defs/LearnedConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "minRecord": {
          "description": "Changes an agent setup needs on record before it may use the\n`auto-merge` lane. Default 10.",
          "type": "integer",
          "format": "uint32",
          "default": 10,
          "minimum": 0
        },
        "rules": {
          "description": "Rules, in any order: a rule with `match: every` can set a lower\nstarting lane when every row of the change matches it; every other\nrule and the hard floors only move a change up.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/LaneRule"
          }
        },
        "taste": {
          "description": "An optional reviewer command for taste, run last by the judge. It can\nraise concerns that send the change to a person, never approve it.",
          "anyOf": [
            {
              "$ref": "#/$defs/TasteCommand"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "LearnedConfig": {
      "description": "A learned model that may raise a change's lane, never lower it\n(`onus help lanes`).",
      "type": "object",
      "properties": {
        "human": {
          "description": "Raise lanes below `human` to `human` at or above this risk. Default 0.85.",
          "type": "number",
          "format": "double",
          "default": 0.85
        },
        "judge": {
          "description": "Raise lanes below `judge` to `judge` at or above this risk. Default 0.6.",
          "type": "number",
          "format": "double",
          "default": 0.6
        },
        "model": {
          "description": "The model file from `onus lanes train`, relative to the repository\nroot. Its name must end in `lanes-model.json`, so a change to it goes\nto a person. Default `onus.lanes-model.json`.",
          "type": "string",
          "default": "onus.lanes-model.json"
        }
      },
      "additionalProperties": false
    },
    "OneOrMany": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "PrismaConfig": {
      "type": "object",
      "properties": {
        "clients": {
          "description": "Identifiers that hold a Prisma client. Default: `prisma`.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "RiskInputs": {
      "description": "The built-in risk inputs of the classifier. They are on by default and\nonly ever raise a lane. Writing a field replaces its default as a whole.",
      "type": "object",
      "properties": {
        "blastRadius": {
          "description": "Other components that depend on what a row changed. Default\n`{ judge: 3 }`; `{}` turns it off.",
          "$ref": "#/$defs/Thresholds",
          "default": {
            "judge": 3
          }
        },
        "confidence": {
          "description": "Rows that rest on parts of the map Onus could not resolve.",
          "$ref": "#/$defs/ConfidenceInput",
          "default": {
            "low": "judge"
          }
        },
        "history": {
          "description": "Reverts, rollbacks and incidents in the components a change touches,\nfrom the outcome records.",
          "$ref": "#/$defs/HistoryInput",
          "default": {
            "days": 90,
            "incidents": {
              "human": 1
            },
            "reverts": {
              "judge": 1
            }
          }
        },
        "tests": {
          "description": "Rows that change code no test exercises and no trace has observed.",
          "$ref": "#/$defs/TestsInput",
          "default": {
            "untested": "judge"
          }
        }
      },
      "additionalProperties": false
    },
    "RuleConfig": {
      "type": "object",
      "properties": {
        "deny": {
          "$ref": "#/$defs/RuleEndpointsConfig"
        }
      },
      "additionalProperties": false,
      "required": [
        "deny"
      ]
    },
    "RuleEndpointsConfig": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ]
    },
    "RuleMatch": {
      "type": "string",
      "enum": [
        "any",
        "every"
      ]
    },
    "Sensitivity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "TasteCommand": {
      "description": "A reviewer program run on the operator's machine: it gets the\nsubmission (without the author's reasoning) as JSON on stdin and prints\none concern per line starting with `concern:`.",
      "type": "object",
      "properties": {
        "command": {
          "description": "The program and its arguments.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "command"
      ]
    },
    "TestsConfig": {
      "type": "object",
      "properties": {
        "command": {
          "description": "How to run one test file, `{test}` replaced by its path\n(e.g. `npx vitest run {test}`). Used to reproduce failing-test\nevidence of escalations. Unset: they are not reproduced.",
          "type": [
            "string",
            "null"
          ]
        },
        "globs": {
          "description": "Globs of test files. Defaults cover `*.test.*`, `*.spec.*` and\n`__tests__/`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "TestsInput": {
      "type": "object",
      "properties": {
        "untested": {
          "description": "The lane of a change with a row whose code no test exercises and no\ntrace has observed. Default `judge`; `auto-merge` turns it off.",
          "$ref": "#/$defs/Lane",
          "default": "judge"
        }
      },
      "additionalProperties": false
    },
    "Thresholds": {
      "description": "Counts at which a lane applies; the highest one met wins. A threshold of\nN means N or more; an unset one never applies.",
      "type": "object",
      "properties": {
        "blocked": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "human": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "judge": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
