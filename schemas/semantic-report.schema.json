{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SemanticReport",
  "type": "object",
  "properties": {
    "base": {
      "type": "string"
    },
    "behavior": {
      "description": "What the behavior diff ran (`onus report --behavior`, ADR 0019);\nabsent without the flag.",
      "anyOf": [
        {
          "$ref": "#/$defs/BehaviorRun"
        },
        {
          "type": "null"
        }
      ]
    },
    "changes": {
      "description": "Ranked, most important first.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemanticChange"
      }
    },
    "coverage": {
      "description": "Which changed lines tests ran, when coverage of the head was given.",
      "anyOf": [
        {
          "$ref": "#/$defs/ReportCoverage"
        },
        {
          "type": "null"
        }
      ]
    },
    "head": {
      "type": "string"
    },
    "intentCheck": {
      "anyOf": [
        {
          "$ref": "#/$defs/IntentCheck"
        },
        {
          "type": "null"
        }
      ]
    },
    "mapDiagnostics": {
      "description": "Diagnostics of the head map in files this change touches.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MapDiagnostic"
      }
    },
    "ruleViolations": {
      "description": "New boundary-rule violations (also listed in `changes`).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemanticChange"
      }
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "structure": {
      "$ref": "#/$defs/StructureNotes"
    },
    "summary": {
      "$ref": "#/$defs/ReportSummary"
    },
    "textStats": {
      "$ref": "#/$defs/TextStats"
    }
  },
  "required": [
    "schemaVersion",
    "base",
    "head",
    "summary",
    "changes",
    "ruleViolations",
    "structure",
    "textStats",
    "mapDiagnostics"
  ],
  "$defs": {
    "BehaviorRun": {
      "description": "What `onus report --behavior` ran and how far it got.",
      "type": "object",
      "properties": {
        "alreadyFailing": {
          "description": "Cases that fail at the base and at the head with the same message.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budgetSecs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "command": {
          "description": "The command template, as configured (`environment.behavior.command`).",
          "type": "string"
        },
        "elapsedSecs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "flaky": {
          "description": "Cases that failed at the head and passed when run again: `file › case`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "description": "Why it is partial or skipped.",
          "type": [
            "string",
            "null"
          ]
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BehaviorSideRun"
          }
        },
        "selected": {
          "description": "The test files that reach the change, changed tests first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SelectedTest"
          }
        },
        "status": {
          "$ref": "#/$defs/BehaviorStatus"
        },
        "truncated": {
          "description": "Test files that reach the change but were left out by `maxFiles`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "status",
        "command",
        "budgetSecs",
        "elapsedSecs",
        "selected",
        "truncated",
        "runs",
        "flaky",
        "alreadyFailing"
      ]
    },
    "BehaviorSideRun": {
      "description": "One run of the behavior command.",
      "type": "object",
      "properties": {
        "cases": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "commit": {
          "description": "The commit whose code ran.",
          "type": "string"
        },
        "exitCode": {
          "description": "None when it timed out.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "failed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "files": {
          "description": "Test files given to the command.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "manifest": {
          "description": "The run's id in the evidence store (`onus evidence show <id>`).",
          "type": [
            "string",
            "null"
          ]
        },
        "side": {
          "$ref": "#/$defs/RunSide"
        },
        "skipped": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "timedOut": {
          "type": "boolean"
        }
      },
      "required": [
        "side",
        "commit",
        "files",
        "timedOut",
        "cases",
        "failed",
        "skipped"
      ]
    },
    "BehaviorStatus": {
      "oneOf": [
        {
          "description": "Every run it needed ran.",
          "type": "string",
          "const": "complete"
        },
        {
          "description": "Some runs ran; `reason` says which did not.",
          "type": "string",
          "const": "partial"
        },
        {
          "description": "Nothing was compared; `reason` says why.",
          "type": "string",
          "const": "skipped"
        }
      ]
    },
    "ChangeKind": {
      "description": "The manifesto's change kinds.",
      "type": "string",
      "enum": [
        "additive",
        "breaking",
        "internal",
        "dependency",
        "config",
        "test",
        "security-sensitive"
      ]
    },
    "ChangeLevel": {
      "type": "string",
      "enum": [
        "relationship",
        "behavior",
        "structure"
      ]
    },
    "Confidence": {
      "description": "How a fact in the map is known.\n\nOrdered from most to least trustworthy, so `max()` over a set of facts\ngives the weakest one.",
      "oneOf": [
        {
          "description": "Written down by a person in `onus.yaml`.",
          "type": "string",
          "const": "declared"
        },
        {
          "description": "Confirmed by the language's own compiler, indexer or language server.",
          "type": "string",
          "const": "compiler"
        },
        {
          "description": "Read directly from the syntax.",
          "type": "string",
          "const": "static"
        },
        {
          "description": "Observed at runtime (later phases).",
          "type": "string",
          "const": "traced"
        },
        {
          "description": "Guessed from conventions or heuristics.",
          "type": "string",
          "const": "inferred"
        },
        {
          "description": "Onus could not resolve it; treat as higher risk.",
          "type": "string",
          "const": "low"
        }
      ]
    },
    "CoverageFormat": {
      "type": "string",
      "enum": [
        "lcov",
        "cobertura",
        "istanbul"
      ]
    },
    "CoverageOrigin": {
      "oneOf": [
        {
          "description": "A file given on the command line or in onus.yaml.",
          "type": "string",
          "const": "supplied"
        },
        {
          "description": "An artifact of a run an environment recorded at this commit.",
          "type": "string",
          "const": "recorded"
        }
      ]
    },
    "CoverageSource": {
      "type": "object",
      "properties": {
        "command": {
          "description": "The command of the run that recorded it.",
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "description": "Its files that matched a map file.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "format": {
          "$ref": "#/$defs/CoverageFormat"
        },
        "manifest": {
          "description": "The evidence manifest it was recorded in.",
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/$defs/CoverageOrigin"
        },
        "path": {
          "description": "The file as given, or the artifact's path in the environment.",
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "unmatched": {
          "description": "Its files that matched none.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "format",
        "path",
        "sha256",
        "origin",
        "files",
        "unmatched"
      ]
    },
    "Hints": {
      "type": "object",
      "properties": {
        "blastRadius": {
          "description": "Files (outside tests) that depend on the subject in the head map.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "coverage": {
          "description": "The row's changed executable lines and how many ran in tests; absent\nwithout coverage, or when the row changes no executable head line.",
          "anyOf": [
            {
              "$ref": "#/$defs/LineCoverage"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependentComponents": {
          "description": "Other components (not the row's own) that depend on what the row\nchanged in the head map (the base map for removed code): the subject,\nor for a component's internal row, the symbols its changed lines are\nin.",
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "dependents": {
          "description": "Those components' ids, sorted.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "intentMismatch": {
          "description": "The change is outside the stated intent.",
          "type": "boolean"
        },
        "labels": {
          "description": "Sensitivity labels of the components involved.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "needsPerson": {
          "description": "A person should look at this row.",
          "type": "boolean"
        },
        "novelty": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owners": {
          "description": "Owners of the components involved (onus.yaml, else CODEOWNERS), for\nrouting a review. Sorted.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rulesOfTheGame": {
          "description": "Tests, CI, policies, labels or declared contracts were touched.",
          "type": "boolean"
        },
        "tested": {
          "description": "How well tests and traces cover the code the row changes; absent\nwhen the row changes no code (config, dependencies, tests).",
          "anyOf": [
            {
              "$ref": "#/$defs/TestReach"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "labels",
        "blastRadius",
        "novelty",
        "confidence",
        "rulesOfTheGame",
        "intentMismatch",
        "needsPerson"
      ]
    },
    "IntentCheck": {
      "type": "object",
      "properties": {
        "contracts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mismatches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IntentMismatch"
          }
        },
        "stated": {
          "type": "string"
        },
        "touches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "stated",
        "touches",
        "contracts",
        "externals",
        "mismatches"
      ]
    },
    "IntentMismatch": {
      "type": "object",
      "properties": {
        "changeId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "changeId",
        "reason"
      ]
    },
    "LineCoverage": {
      "description": "Changed executable lines of a row (or a report) and how many ran in tests.",
      "type": "object",
      "properties": {
        "changed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "ran": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "changed",
        "ran"
      ]
    },
    "Location": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "lines": {
          "description": "First and last line, inclusive, 1-based.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "maxItems": 2,
          "minItems": 2
        },
        "side": {
          "description": "Which tree the lines refer to.",
          "$ref": "#/$defs/Side"
        }
      },
      "required": [
        "file",
        "lines",
        "side"
      ]
    },
    "MapDiagnostic": {
      "type": "object",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "file": {
          "type": "string"
        },
        "kind": {
          "description": "`unresolved-import`, `dynamic-import`, `dynamic-access`,\n`dynamic-event-name`, `parse-error`, `no-entrypoint`, …",
          "type": "string"
        },
        "line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "file",
        "line",
        "message",
        "confidence"
      ]
    },
    "MovedFile": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "ReportCoverage": {
      "description": "The changed lines tests ran, from coverage of the head (ADR 0017).",
      "type": "object",
      "properties": {
        "changed": {
          "description": "Added or edited head lines the coverage counts as executable.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "notMeasured": {
          "description": "Changed source files with runtime code that the coverage does not\ninclude.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notRun": {
          "description": "Changed executable lines no test ran (head side), grouped into ranges.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Location"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ran": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CoverageSource"
          }
        }
      },
      "required": [
        "sources",
        "changed",
        "ran",
        "notRun",
        "notMeasured"
      ]
    },
    "ReportSummary": {
      "type": "object",
      "properties": {
        "intentMismatches": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "meaningChanges": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "needsAttention": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "newRuleViolations": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "secrets": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "meaningChanges",
        "needsAttention",
        "secrets",
        "newRuleViolations",
        "intentMismatches"
      ]
    },
    "RunSide": {
      "description": "Which run.",
      "oneOf": [
        {
          "description": "The base's tests on the base's code.",
          "type": "string",
          "const": "base"
        },
        {
          "description": "The head's tests on the head's code.",
          "type": "string",
          "const": "head"
        },
        {
          "description": "The head's files with failing cases, run once more at the head.",
          "type": "string",
          "const": "retry"
        },
        {
          "description": "The base versions of edited tests on the head's code.",
          "type": "string",
          "const": "cross"
        }
      ]
    },
    "SelectedTest": {
      "description": "A test file chosen from the maps.",
      "type": "object",
      "properties": {
        "base": {
          "description": "It exists at the base, and so ran there.",
          "type": "boolean"
        },
        "changed": {
          "description": "The test file itself changed.",
          "type": "boolean"
        },
        "depth": {
          "description": "Code-dependency hops from a changed file (0: it exercises one).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "file": {
          "type": "string"
        },
        "head": {
          "description": "It exists at the head.",
          "type": "boolean"
        },
        "via": {
          "description": "The changed file it reaches.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "file",
        "changed",
        "depth",
        "base",
        "head"
      ]
    },
    "SemanticChange": {
      "type": "object",
      "properties": {
        "component": {
          "description": "The component the change happens in, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "hints": {
          "$ref": "#/$defs/Hints"
        },
        "id": {
          "description": "Deterministic id: `<subkind>:<subject>` plus a suffix when needed.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ChangeKind"
        },
        "kindLabel": {
          "description": "Short label for the Kind column, e.g. \"Contract change, additive\".",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/ChangeLevel"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Location"
          }
        },
        "stats": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stats"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "description": "The map id the change is about.",
          "type": "string"
        },
        "subkind": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "whyItMatters": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "subkind",
        "level",
        "subject",
        "kindLabel",
        "title",
        "whyItMatters",
        "hints",
        "locations"
      ]
    },
    "Side": {
      "type": "string",
      "enum": [
        "base",
        "head"
      ]
    },
    "Stats": {
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "linesAdded": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "linesRemoved": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "linesAdded",
        "linesRemoved",
        "files"
      ]
    },
    "StructureNotes": {
      "description": "Changes that move code without changing what it means.",
      "type": "object",
      "properties": {
        "formattingOnly": {
          "description": "Files whose only changes are formatting, comments or updated import\npaths.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "movedFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MovedFile"
          }
        }
      },
      "required": [
        "movedFiles",
        "formattingOnly"
      ]
    },
    "TestReach": {
      "description": "Whether tests or traces reach the files a row changes. File granularity:\na file counts as tested when a test exercises any symbol in it.",
      "oneOf": [
        {
          "description": "A test in the head map exercises every changed code file.",
          "type": "string",
          "const": "tested"
        },
        {
          "description": "Every changed code file is tested or seen in a runtime trace.",
          "type": "string",
          "const": "traced"
        },
        {
          "description": "At least one changed code file is neither.",
          "type": "string",
          "const": "untested"
        }
      ]
    },
    "TextStats": {
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "linesAdded": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "linesRemoved": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "files",
        "linesAdded",
        "linesRemoved"
      ]
    }
  }
}
