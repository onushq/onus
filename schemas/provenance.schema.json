{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProvenanceRecord",
  "description": "Everything Onus knows about why one change was allowed through.",
  "type": "object",
  "properties": {
    "agent": {
      "$ref": "#/$defs/Agent"
    },
    "approval": {
      "$ref": "#/$defs/Approval"
    },
    "change": {
      "description": "`owner/repo#123`, or a head commit for a local change.",
      "type": "string"
    },
    "commits": {
      "$ref": "#/$defs/Commits"
    },
    "digest": {
      "description": "sha256 (hex) of this record's compact JSON with `digest` empty.",
      "type": "string"
    },
    "doors": {
      "description": "Door decisions for the task, from the audit log.",
      "anyOf": [
        {
          "$ref": "#/$defs/Doors"
        },
        {
          "type": "null"
        }
      ]
    },
    "escalations": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Escalation"
      }
    },
    "evidence": {
      "description": "Test runs handed in with the change.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Evidence"
      }
    },
    "gaps": {
      "description": "What this record could not establish, and why.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Gap"
      }
    },
    "generatedAt": {
      "description": "Unix seconds.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "intent": {
      "anyOf": [
        {
          "$ref": "#/$defs/Intent"
        },
        {
          "type": "null"
        }
      ]
    },
    "judge": {
      "anyOf": [
        {
          "$ref": "#/$defs/Judge"
        },
        {
          "type": "null"
        }
      ]
    },
    "lane": {
      "anyOf": [
        {
          "$ref": "#/$defs/LaneFacts"
        },
        {
          "type": "null"
        }
      ]
    },
    "onus": {
      "description": "The Onus version that built the record.",
      "type": "string"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReportFacts"
        },
        {
          "type": "null"
        }
      ]
    },
    "rollout": {
      "$ref": "#/$defs/Rollout"
    },
    "schema": {
      "description": "[`SCHEMA`].",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "stage": {
      "$ref": "#/$defs/Stage"
    },
    "token": {
      "description": "The task token the change was made under. Never the token itself.",
      "anyOf": [
        {
          "$ref": "#/$defs/Token"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "change",
    "stage",
    "generatedAt",
    "onus",
    "commits",
    "agent",
    "approval",
    "rollout",
    "digest"
  ],
  "$defs": {
    "Agent": {
      "type": "object",
      "properties": {
        "config": {
          "type": "string",
          "default": ""
        },
        "detectedFrom": {
          "description": "How it was known: `trailer`, `branch`, `bot`, `co-author`, `person`,\n`submission`, `record` (a pull record) or `outcome`.",
          "type": "string"
        },
        "key": {
          "description": "`tool/model/config`, the key outcomes are recorded under.",
          "type": "string"
        },
        "model": {
          "type": "string",
          "default": ""
        },
        "record": {
          "description": "Its track record when the record was built.",
          "anyOf": [
            {
              "$ref": "#/$defs/TrackRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "team": {
          "type": "string",
          "default": ""
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "key",
        "detectedFrom"
      ]
    },
    "Approval": {
      "type": "object",
      "properties": {
        "by": {
          "$ref": "#/$defs/ApprovedBy"
        },
        "judge": {
          "description": "The judge configuration, when the judge approved.",
          "type": [
            "string",
            "null"
          ]
        },
        "mergedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "people": {
          "description": "Everyone who approved (`@login`): row approvers, approving reviewers\nand who merged it, each once, in that order.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "review": {
          "description": "Whose approving review counted (`lanes.approval`): `owner` or\n`member`.",
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalRule"
            },
            {
              "type": "null"
            }
          ]
        },
        "rows": {
          "description": "Rows of the report a person approved.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RowApproval"
          }
        }
      },
      "required": [
        "by"
      ]
    },
    "ApprovalRule": {
      "description": "Whose approving review counts in the human lane.",
      "oneOf": [
        {
          "description": "One of the change's owners, or a member of an owning team.",
          "type": "string",
          "const": "owner"
        },
        {
          "description": "Any person with write access who did not open the pull request.",
          "type": "string",
          "const": "member"
        }
      ]
    },
    "ApprovedBy": {
      "description": "Who or what let the change through.",
      "oneOf": [
        {
          "description": "The lane policy: it was in the auto-merge lane.",
          "type": "string",
          "const": "policy"
        },
        {
          "description": "The judge approved it.",
          "type": "string",
          "const": "judge"
        },
        {
          "description": "A person.",
          "type": "string",
          "const": "person"
        },
        {
          "description": "It merged although Onus blocked it.",
          "type": "string",
          "const": "override"
        },
        {
          "description": "Still open.",
          "type": "string",
          "const": "pending"
        },
        {
          "description": "Closed without merging.",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "CallDenial": {
      "description": "A call Onus Cloud refused.",
      "type": "object",
      "properties": {
        "at": {
          "description": "Unix seconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "method": {
          "type": "string"
        },
        "reason": {
          "description": "The denial, as Onus Cloud sent it back.",
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "type": "string"
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "tokenId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "at",
        "method",
        "route"
      ]
    },
    "CallsSource": {
      "description": "Where Onus Cloud's calls came from: only ever Onus Cloud.",
      "oneOf": [
        {
          "description": "Onus Cloud's own log of the calls made under the task token, on its\nword: it has no hash chain.",
          "type": "string",
          "const": "onus-cloud"
        }
      ]
    },
    "CloudCalls": {
      "description": "Onus Cloud's log of the calls made under a task token, summed up.",
      "type": "object",
      "properties": {
        "allowed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "denials": {
          "description": "Every call Onus Cloud refused, in time order (at most 100).",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/CallDenial"
          }
        },
        "denied": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "failed": {
          "description": "Calls the API could not answer.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "firstAt": {
          "description": "Unix seconds of the first and the last call.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "lastAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "routes": {
          "description": "The calls by route and scope, with how each was decided.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RouteCalls"
          }
        },
        "source": {
          "description": "Always `onus-cloud`, so these are never taken for the door log.",
          "$ref": "#/$defs/CallsSource"
        },
        "tokens": {
          "description": "The ids of the tokens the calls were made with; never a token.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "total": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "untasked": {
          "description": "Calls that name no task, counted as the change's on Onus Cloud's\nword.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "source",
        "total",
        "allowed",
        "denied"
      ]
    },
    "Commits": {
      "type": "object",
      "properties": {
        "base": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "merge": {
          "description": "The commit it landed as.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "base",
        "head"
      ]
    },
    "DoorEntry": {
      "description": "One door decision, as the audit log holds it.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "decision": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "subject": {
          "type": "string"
        }
      },
      "required": [
        "seq",
        "at",
        "actor",
        "action",
        "subject",
        "decision",
        "reason",
        "hash"
      ]
    },
    "DoorSource": {
      "description": "Where door decisions came from, when not the door log (audit.jsonl)\nthis run read.",
      "oneOf": [
        {
          "description": "The task's slice of the door log, attached to its work in Onus Cloud\n(`onus cloud evidence --door-log`); its chain is checked here.",
          "type": "string",
          "const": "attached"
        },
        {
          "description": "Onus Cloud's own log of the calls made under the task token. Onus\nCloud's word: it has no hash chain.",
          "type": "string",
          "const": "onus-cloud"
        }
      ]
    },
    "Doors": {
      "type": "object",
      "properties": {
        "calls": {
          "description": "Onus Cloud's log of the calls made under the task token, summed up.",
          "anyOf": [
            {
              "$ref": "#/$defs/CloudCalls"
            },
            {
              "type": "null"
            }
          ]
        },
        "entries": {
          "description": "The task's door decisions, from the door log.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/DoorEntry"
          }
        },
        "intact": {
          "description": "The door log's hash chain verified: the whole log, or an attached\nslice from its first entry. False when only Onus Cloud's calls are\nknown (`source: onus-cloud`): they have no chain to check.",
          "type": "boolean"
        },
        "source": {
          "description": "Where `entries` came from. Absent: the door log this run read.",
          "anyOf": [
            {
              "$ref": "#/$defs/DoorSource"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "intact"
      ]
    },
    "Escalation": {
      "type": "object",
      "properties": {
        "at": {
          "description": "Unix seconds.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "bestGrade": {
          "description": "The strongest evidence grade (1 is strongest).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "by": {
          "description": "Who decided: a person, or `policy` for an automatic grant.",
          "type": [
            "string",
            "null"
          ]
        },
        "cloudId": {
          "description": "Onus Cloud's id for it, when it was filed there.",
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "description": "`granted`, `denied`, `needs-person`, `answered` or `open`; from Onus\nCloud also `withdrawn`, `expired` or `failed`.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "description": "`permission`, `broken-test`, `contradictory-spec` or `impossible-task`.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Why it was decided so: the door log's reason, or Onus Cloud's\n`answer`. Never why the agent asked.",
          "type": [
            "string",
            "null"
          ]
        },
        "scopes": {
          "description": "The rights asked for.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "decision"
      ]
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "atHead": {
          "description": "It ran at the head commit.",
          "type": "boolean"
        },
        "command": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "exitCode": {
          "type": "integer",
          "format": "int32"
        },
        "image": {
          "type": "string"
        },
        "manifest": {
          "description": "The evidence-store manifest, when it ran in an environment.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command",
        "commit",
        "image",
        "exitCode",
        "atHead"
      ]
    },
    "Gap": {
      "description": "Something the record cannot vouch for.",
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "reason": {
          "description": "Why, and how to fill it.",
          "type": "string"
        }
      },
      "required": [
        "field",
        "reason"
      ]
    },
    "Intent": {
      "type": "object",
      "properties": {
        "check": {
          "description": "The report's check of the intent against what changed.",
          "anyOf": [
            {
              "$ref": "#/$defs/IntentCheck"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "description": "sha256 (hex) of the intent text as given.",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/IntentSource"
        }
      },
      "required": [
        "source",
        "sha256"
      ]
    },
    "IntentCheck": {
      "type": "object",
      "properties": {
        "contracts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mismatches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IntentMismatch"
          }
        },
        "stated": {
          "type": "string"
        },
        "touches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "stated",
        "touches",
        "contracts",
        "externals",
        "mismatches"
      ]
    },
    "IntentMismatch": {
      "type": "object",
      "properties": {
        "changeId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "changeId",
        "reason"
      ]
    },
    "IntentSource": {
      "oneOf": [
        {
          "description": "The pull request body.",
          "type": "string",
          "const": "pull-request"
        },
        {
          "description": "A submission (`onus submit`, `onus_submit`).",
          "type": "string",
          "const": "submission"
        }
      ]
    },
    "Judge": {
      "type": "object",
      "properties": {
        "id": {
          "description": "The judge configuration that decided.",
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/JudgeStep"
          }
        },
        "verdict": {
          "description": "`approve`, `reject` or `escalate`.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "verdict"
      ]
    },
    "JudgeStep": {
      "type": "object",
      "properties": {
        "details": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "status": {
          "description": "`passed`, `failed`, `skipped` or `concern`.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status"
      ]
    },
    "Lane": {
      "description": "What happens to a change, from least to most scrutiny.",
      "oneOf": [
        {
          "description": "Merged once required checks pass.",
          "type": "string",
          "const": "auto-merge"
        },
        {
          "description": "Verified by the judge (`onus judge`), then merged or escalated.",
          "type": "string",
          "const": "judge"
        },
        {
          "description": "A person reviews it.",
          "type": "string",
          "const": "human"
        },
        {
          "description": "It may not merge as it is.",
          "type": "string",
          "const": "blocked"
        }
      ]
    },
    "LaneFacts": {
      "type": "object",
      "properties": {
        "applied": {
          "description": "Every rule that applied, in order.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/LaneReason"
          }
        },
        "lane": {
          "description": "The final lane, after the judge.",
          "$ref": "#/$defs/Lane"
        },
        "policy": {
          "description": "The lane policy's hash (the judge configuration id).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "lane"
      ]
    },
    "LaneReason": {
      "type": "object",
      "properties": {
        "lane": {
          "$ref": "#/$defs/Lane"
        },
        "reason": {
          "type": "string"
        },
        "rows": {
          "description": "The ids of the report rows behind it.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "description": "`default`, `policy`, `input`, `floor`, `model`, `record` or `audit`.",
          "type": "string"
        }
      },
      "required": [
        "lane",
        "source",
        "reason"
      ]
    },
    "MetricGuard": {
      "description": "A limit on one metric during a rollout. Ratios compare the value with\nits baseline (the control, or the value before the deploy).",
      "type": "object",
      "properties": {
        "max": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "maxRatio": {
          "description": "The most `value / baseline` may be.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "metric": {
          "description": "The metric's name, as the samples give it (`error_rate`).",
          "type": "string"
        },
        "min": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "minRatio": {
          "description": "The least `value / baseline` may be, for metrics that must not drop.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "metric"
      ]
    },
    "PlanFacts": {
      "description": "A rollout plan, as the record keeps it.",
      "type": "object",
      "properties": {
        "automaticRollback": {
          "type": "boolean",
          "default": false
        },
        "bakeMinutes": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "flag": {
          "type": [
            "string",
            "null"
          ]
        },
        "guards": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/MetricGuard"
          }
        },
        "reasons": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "default": [],
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          }
        },
        "strategy": {
          "description": "`none`, `canary` or `flag`.",
          "type": "string"
        }
      },
      "required": [
        "strategy"
      ]
    },
    "ReportFacts": {
      "type": "object",
      "properties": {
        "changedFiles": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "needsPerson": {
          "description": "Ids of the rows that need a person.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "$ref": "#/$defs/ReportSummary"
        }
      },
      "required": [
        "summary",
        "changedFiles"
      ]
    },
    "ReportSummary": {
      "type": "object",
      "properties": {
        "intentMismatches": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "meaningChanges": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "needsAttention": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "newRuleViolations": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "secrets": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "meaningChanges",
        "needsAttention",
        "secrets",
        "newRuleViolations",
        "intentMismatches"
      ]
    },
    "Rollout": {
      "type": "object",
      "properties": {
        "at": {
          "description": "When it merged or closed (Unix seconds).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "audited": {
          "description": "A person audited it after it merged.",
          "type": "boolean",
          "default": false
        },
        "commit": {
          "description": "The commit it landed as.",
          "type": [
            "string",
            "null"
          ]
        },
        "history": {
          "description": "Every outcome of the change, in order.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RolloutEvent"
          }
        },
        "missed": {
          "description": "The audit found a problem the automatic path missed.",
          "type": "boolean",
          "default": false
        },
        "percent": {
          "description": "The share of production traffic last reported (a deploy or a rollout\nstage).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "plan": {
          "description": "The plan for the change's final lane, from its pull record.",
          "anyOf": [
            {
              "$ref": "#/$defs/PlanFacts"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "description": "`open`, `merged`, `closed`, `reverted`, `rolled-back` or `incident`.",
          "type": "string"
        },
        "signals": {
          "description": "Every other production signal tied to the change, in time order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SignalRef"
          }
        },
        "stages": {
          "description": "Every deploy and rollout stage of the change, in time order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/StageEvent"
          }
        },
        "status": {
          "description": "Where the change is in production, from its outcomes and its deploy\nand rollout stages.",
          "anyOf": [
            {
              "$ref": "#/$defs/RolloutStatus"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "result"
      ]
    },
    "RolloutEvent": {
      "type": "object",
      "properties": {
        "at": {
          "description": "Unix seconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "involved": {
          "description": "For an incident: the components and symbols it involved.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "type": "string"
        }
      },
      "required": [
        "at",
        "result"
      ]
    },
    "RolloutStatus": {
      "description": "Where a change is in production.",
      "oneOf": [
        {
          "description": "Still open.",
          "type": "string",
          "const": "pending"
        },
        {
          "description": "Closed without merging.",
          "type": "string",
          "const": "not-shipped"
        },
        {
          "description": "Merged; no production deploy or rollout stage reported yet.",
          "type": "string",
          "const": "awaiting-deploy"
        },
        {
          "description": "Reaching a share of production traffic.",
          "type": "string",
          "const": "in-progress"
        },
        {
          "description": "The last stage holds: not baked yet, or a sample is missing.",
          "type": "string",
          "const": "holding"
        },
        {
          "description": "At all of production traffic.",
          "type": "string",
          "const": "complete"
        },
        {
          "description": "Rolled back: by Onus's decision on a stage, or reported.",
          "type": "string",
          "const": "rolled-back"
        },
        {
          "description": "Reverted after it merged.",
          "type": "string",
          "const": "reverted"
        }
      ]
    },
    "RouteCalls": {
      "description": "The calls to one route, under one scope.",
      "type": "object",
      "properties": {
        "allowed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "denied": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "method": {
          "type": "string"
        },
        "route": {
          "description": "`/v1/orgs/:org/environments/:env/runs`.",
          "type": "string"
        },
        "scope": {
          "description": "What the route needs of a scoped token.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "method",
        "route",
        "allowed",
        "denied"
      ]
    },
    "RowApproval": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string"
        },
        "row": {
          "type": "string"
        }
      },
      "required": [
        "row",
        "by"
      ]
    },
    "SignalRef": {
      "description": "A production signal tied to the change.",
      "type": "object",
      "properties": {
        "at": {
          "description": "Unix seconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "description": "`incident`, `error-spike`, `latency`, `metric` or `rollback`.",
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "at",
        "source"
      ]
    },
    "Stage": {
      "description": "Where the change is: still open, merged, or closed without merging.",
      "type": "string",
      "enum": [
        "open",
        "merged",
        "closed"
      ]
    },
    "StageEvent": {
      "description": "A deploy or rollout stage reported for the change.",
      "type": "object",
      "properties": {
        "at": {
          "description": "Unix seconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "decision": {
          "description": "Onus's decision on a rollout stage: `promote`, `hold`, `rollback` or\n`complete`.",
          "type": [
            "string",
            "null"
          ]
        },
        "deploy": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment": {
          "description": "Absent means production. Stages elsewhere are listed, and do not\ncount toward `status`.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "`deploy` or `rollout`.",
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "percent": {
          "description": "The share of traffic; 100 for a deploy that names none.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "at",
        "kind",
        "percent",
        "source"
      ]
    },
    "Token": {
      "type": "object",
      "properties": {
        "attenuations": {
          "description": "Attenuations, as Datalog.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "expires": {
          "description": "Unix seconds.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "fingerprint": {
          "description": "The first 16 hex digits of the token's sha256; never the token.",
          "type": [
            "string",
            "null"
          ]
        },
        "rights": {
          "description": "The token's rights (`write:path:…`).",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "source": {
          "$ref": "#/$defs/TokenSource"
        },
        "task": {
          "type": "string"
        }
      },
      "required": [
        "task",
        "source"
      ]
    },
    "TokenSource": {
      "description": "Where the token facts come from.",
      "oneOf": [
        {
          "description": "Verified by the run that built the record.",
          "type": "string",
          "const": "token"
        },
        {
          "description": "Verified when the submission was made.",
          "type": "string",
          "const": "submission"
        },
        {
          "description": "The agent's own submission, handed in beside the run (`onus ci pr\n--submission`, `onus provenance --agent-submission`), such as one\nkept on the records branch. On its word: this run cannot tell it was\nverified when it was made, and whoever can write where it was kept\ncould have written it. Ranked below `audit` and `inspection`.",
          "type": "string",
          "const": "agent-submission"
        },
        {
          "description": "The door log's `mint` entry for the task, widened by its grants.",
          "type": "string",
          "const": "audit"
        },
        {
          "description": "The door's inspection of the token (`--token-inspection`, or the one\nOnus Cloud keeps with an escalation), widened by the escalations\ngranted to the task. What the door said it held: this run did not\nverify it.",
          "type": "string",
          "const": "inspection"
        },
        {
          "description": "The door log the agent attached to its work in Onus Cloud: the\ndoor's inspection sent with it, or its `mint` entry, widened by its\ngrants. Taken only when its chain verifies, and ranked below the\nrest: whoever attached it chose what it holds.",
          "type": "string",
          "const": "attached"
        }
      ]
    },
    "TrackRecord": {
      "type": "object",
      "properties": {
        "merged": {
          "description": "Changes still merged (not reverted, no incident).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "recentIncidents": {
          "description": "Incidents among its recent changes.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "recentRollbacks": {
          "description": "Rollbacks, not planned, among its recent changes.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "merged",
        "recentIncidents"
      ]
    }
  }
}
