{
  "name": "onus-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The web interface of `onus ui`, embedded in the onus binary",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
